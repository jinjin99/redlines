{
  "name": "redlines",
  "version": "0.1.0",
  "description": "See what a UI change does, state by state: before and after of every page, each change found, boxed and numbered.",
  "type": "module",
  "bin": {
    "redlines": "dist/bin/redlines.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "demo": "tsc && node dist/scripts/demo.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.63.0",
    "zod": "3.25.76"
  },
  "keywords": [
    "ui",
    "diff",
    "visual-review",
    "design",
    "redlines",
    "playwright"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.19.43",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3"
  },
  "types": "dist/src/index.d.ts"
}
