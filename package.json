{
  "name": "redlines",
  "version": "0.4.0",
  "description": "See what a UI change does, state by state: before and after of every page, each change found, boxed and numbered.",
  "keywords": [
    "ui",
    "diff",
    "visual-review",
    "visual-regression",
    "design",
    "design-review",
    "redlines",
    "playwright",
    "mcp",
    "msw"
  ],
  "homepage": "https://github.com/jinjin99/redlines#readme",
  "bugs": {
    "url": "https://github.com/jinjin99/redlines/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinjin99/redlines.git"
  },
  "license": "MIT",
  "author": "jinjin99",
  "type": "module",
  "bin": {
    "redlines": "dist/bin/redlines.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "dist/bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "tsc && node scripts/test.mjs",
    "demo": "tsc && node dist/scripts/demo.js",
    "prepublishOnly": "npm run lint && npm test",
    "prepare": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "mockttp": "4.6.3",
    "playwright-core": "1.63.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "msw": ">=2.4"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.12.0",
    "msw": "2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
